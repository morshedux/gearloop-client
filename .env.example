# Express API base URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public URL of this Next.js app (used by Better Auth)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# MongoDB (same database the Express server uses)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=gearloop

# Shared with the Express server so it can verify access tokens
JWT_SECRET=change-me-to-a-long-random-string

# Google social login (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# imgbb image upload key (https://api.imgbb.com/)
NEXT_PUBLIC_IMGBB_KEY=
